@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Mess Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --bg-primary: #f8f9fc;
            --bg-secondary: #ffffff;
            --bg-card: #ffffff;
            --bg-hover: #f1f3f5;
            --text-primary: #2d3748;
            --text-secondary: #718096;
            --text-muted: #a0aec0;
            --border-color: #e2e8f0;
            --input-bg: #ffffff;
            --input-border: #cbd5e0;
            --shadow: rgba(0, 0, 0, 0.1);
            --shadow-hover: rgba(0, 0, 0, 0.15);
            --primary-gradient: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        }

        [data-theme="dark"] {
            --bg-primary: #1a202c;
            --bg-secondary: #2d3748;
            --bg-card: #2d3748;
            --bg-hover: #374151;
            --text-primary: #f7fafc;
            --text-secondary: #cbd5e0;
            --text-muted: #a0aec0;
            --border-color: #4a5568;
            --input-bg: #374151;
            --input-border: #4a5568;
            --shadow: rgba(0, 0, 0, 0.4);
            --shadow-hover: rgba(0, 0, 0, 0.6);
            --primary-gradient: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
        }

        body {
            background: var(--bg-primary);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
            position: relative;
        }

        .theme-toggle {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            background: var(--bg-card);
            border: 2px solid var(--border-color);
            border-radius: 50px;
            padding: 8px 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 4px 12px var(--shadow);
        }

        .theme-toggle:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px var(--shadow);
        }

        .theme-toggle i {
            font-size: 1.2rem;
            color: var(--text-primary);
        }

        .theme-toggle span {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        .login-container {
            max-width: 420px;
            width: 100%;
        }

        .login-card {
            background: var(--bg-card);
            border-radius: 16px;
            box-shadow: 0 8px 32px var(--shadow);
            overflow: hidden;
            border: 1px solid var(--border-color);
        }

        .login-help {
            background: rgba(17, 153, 142, 0.1);
            border-left: 4px solid #11998e;
            padding: 12px 16px;
            margin-bottom: 20px;
            border-radius: 8px;
            font-size: 0.9rem;
            color: var(--text-primary);
        }

        .login-header {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: white;
            padding: 2.5rem 2rem;
            text-align: center;
        }

        .login-header i {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        .login-header h2 {
            margin: 0;
            font-weight: 700;
            font-size: 1.85rem;
            margin-bottom: 0.5rem;
        }

        .login-header p {
            margin: 0.5rem 0 0 0;
            opacity: 0.95;
            font-size: 1rem;
            line-height: 1.5;
        }

        .login-header .subtitle {
            font-size: 0.9rem;
            opacity: 0.85;
            margin-top: 0.75rem;
            padding: 0.5rem 1rem;
            background: rgba(255,255,255,0.15);
            border-radius: 20px;
            display: inline-block;
        }

        .login-body {
            padding: 2rem;
            background: var(--bg-card);
        }

        .form-label {
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
        }

        .form-label i {
            margin-right: 6px;
            color: #11998e;
        }

        .form-control {
            border-radius: 10px;
            padding: 12px 16px;
            border: 2px solid var(--border-color);
            background: var(--input-bg);
            color: var(--text-primary);
            transition: all 0.3s ease;
        }

        .form-control::placeholder {
            color: var(--text-muted);
        }

        .form-control:focus {
            border-color: #11998e;
            box-shadow: 0 0 0 3px rgba(17, 153, 142, 0.1);
            background: var(--input-bg);
            color: var(--text-primary);
        }

        .input-group-text {
            background: var(--bg-hover);
            border: 2px solid var(--border-color);
            border-right: none;
            border-radius: 10px 0 0 10px;
            color: var(--text-secondary);
        }

        .input-group .form-control {
            border-left: none;
            border-radius: 0 10px 10px 0;
        }

        .input-group:focus-within .input-group-text {
            border-color: #11998e;
        }

        .btn-outline-primary,
        .btn-outline-success {
            border-radius: 10px;
            padding: 12px;
            font-weight: 600;
            border-width: 2px;
            transition: all 0.3s ease;
        }

        .btn-outline-primary {
            color: #11998e;
            border-color: #11998e;
        }

        .btn-outline-primary:hover,
        .btn-check:checked + .btn-outline-primary {
            background: #11998e;
            border-color: #11998e;
            color: white;
        }

        .btn-outline-success {
            color: #198754;
            border-color: #198754;
        }

        .btn-outline-success:hover,
        .btn-check:checked + .btn-outline-success {
            background: #198754;
            border-color: #198754;
            color: white;
        }

        .btn-login {
            background: var(--primary-gradient);
            border: none;
            border-radius: 10px;
            padding: 14px;
            font-weight: 700;
            color: white;
            width: 100%;
            transition: all 0.3s ease;
            font-size: 1rem;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(17, 153, 142, 0.4);
            color: white;
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .alert {
            border-radius: 10px;
            border: none;
            padding: 12px 16px;
        }

        .text-muted {
            color: var(--text-muted) !important;
        }

        .form-text {
            color: var(--text-muted);
        }

        .login-help {
            background: var(--bg-hover);
            border: 1px solid var(--border-color);
            padding: 1rem;
            border-radius: 10px;
            color: var(--text-primary);
            margin-bottom: 1.5rem;
        }

        .login-help p {
            color: var(--text-primary);
            margin: 0;
        }

        .login-help .small {
            color: var(--text-secondary);
        }

        /* Alert styling */
        .alert-danger {
            background-color: rgba(220, 53, 69, 0.1);
            border-left: 4px solid #dc3545;
            color: var(--text-primary);
        }

        [data-theme="dark"] .alert-danger {
            background-color: rgba(220, 53, 69, 0.2);
        }

        .d-grid {
            display: grid;
            gap: 10px;
        }

        @@media (max-width: 576px) {
            .login-header h2 {
                font-size: 1.5rem;
            }
            
            .login-body {
                padding: 1.5rem;
            }

            .theme-toggle {
                top: 10px;
                right: 10px;
                padding: 6px 12px;
            }

            .theme-toggle span {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="theme-toggle" onclick="toggleTheme()">
        <i class="fas fa-moon" id="themeIcon"></i>
        <span id="themeText">Dark Mode</span>
    </div>

    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <i class="fas fa-utensils"></i>
                <h2>Mess Management System</h2>
                <p><strong>🍽️ Attendance & Billing Management</strong></p>
                <div class="subtitle">
                    <i class="fas fa-info-circle"></i> Transparent • Automated • User-Friendly
                </div>
            </div>
            <div class="login-body">
                <!-- Welcome Instructions -->
                <div class="login-help" style="border-left: 4px solid #11998e;">
                    <p class="mb-1"><i class="fas fa-info-circle"></i> <strong>How to Login:</strong></p>
                    <p class="mb-0 small">1. Choose your role (Admin or Teacher)<br>2. Enter your username and password<br>3. Click "Sign In" button</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="fas fa-exclamation-circle"></i> <strong>Login Failed:</strong> @ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            <i class="fas fa-user-tag"></i> I am logging in as:
                        </label>
                        <div class="d-grid gap-2">
                            <input type="radio" class="btn-check" name="role" id="roleAdmin" value="Admin" autocomplete="off" checked>
                            <label class="btn btn-outline-primary" for="roleAdmin" title="Login as administrator to manage the system">
                                <i class="fas fa-user-shield"></i> <strong>Admin</strong> <small>(System Manager)</small>
                            </label>

                            <input type="radio" class="btn-check" name="role" id="roleTeacher" value="Teacher" autocomplete="off">
                            <label class="btn btn-outline-success" for="roleTeacher" title="Login as teacher to view attendance and bills">
                                <i class="fas fa-chalkboard-teacher"></i> <strong>Teacher</strong> <small>(Faculty Member)</small>
                            </label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="username" class="form-label fw-bold">
                            <i class="fas fa-user"></i> Username
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text">
                                <i class="fas fa-user"></i>
                            </span>
                            <input type="text" 
                                   class="form-control" 
                                   id="username" 
                                   name="username" 
                                   placeholder="Enter your username" 
                                   required 
                                   autofocus />
                        </div>
                        <div class="form-text small"><i class="fas fa-info-circle"></i> Your unique username assigned by the admin</div>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label fw-bold">
                            <i class="fas fa-lock"></i> Password
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text">
                                <i class="fas fa-lock"></i>
                            </span>
                            <input type="password" 
                                   class="form-control" 
                                   id="password" 
                                   name="password" 
                                   placeholder="Enter your password" 
                                   required />
                        </div>
                        <div class="form-text small"><i class="fas fa-shield-alt"></i> Keep your password secure and don't share it</div>
                    </div>

                    <button type="submit" class="btn btn-login btn-lg w-100">
                        <i class="fas fa-sign-in-alt"></i> <strong>Sign In to Your Account</strong>
                    </button>
                </form>

                <div class="text-center mt-4">
                    <small class="text-muted">
                        <i class="fas fa-copyright"></i> 2025 Mess Management System
                    </small>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Dark mode functionality
        function toggleTheme() {
            const html = document.documentElement;
            const currentTheme = html.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            
            html.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            updateThemeIcon(newTheme);
        }

        function updateThemeIcon(theme) {
            const icon = document.getElementById('themeIcon');
            const text = document.getElementById('themeText');
            
            if (theme === 'dark') {
                icon.className = 'fas fa-sun';
                text.textContent = 'Light Mode';
            } else {
                icon.className = 'fas fa-moon';
                text.textContent = 'Dark Mode';
            }
        }

        // Load saved theme on page load
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
            updateThemeIcon(savedTheme);
        })();
    </script>
</body>
</html>
