@model MessManagementSystem.Models.Bill

@{
    ViewData["Title"] = "Make Payment";
}

<div class="container-fluid">
    <!-- Progress Indicator -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                <div class="card-body text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0"><i class="fas fa-credit-card me-2"></i>Secure Payment</h5>
                            <p class="mb-0 small opacity-90"><i class="fas fa-shield-alt me-1"></i> SSL Encrypted • <i class="fas fa-lock me-1"></i> PCI Compliant</p>
                        </div>
                        <div class="text-end">
                            <div class="badge bg-white text-primary px-3 py-2">
                                <i class="fas fa-check-circle me-1"></i> Step 2 of 2
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="ViewBills">My Bills</a></li>
                    <li class="breadcrumb-item active">Make Payment</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Bill Summary -->
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-lg" style="animation: slideIn 0.5s ease-out;">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                    <h5 class="mb-0"><i class="fas fa-file-invoice me-2"></i>Bill Summary</h5>
                    <p class="mb-0 small opacity-90">Review before payment</p>
                </div>
                <div class="card-body">
                    <div class="alert alert-info py-2 px-3 mb-3">
                        <small><i class="fas fa-info-circle me-1"></i><strong>You're paying for:</strong></small>
                    </div>
                    <div class="mb-3 p-3 bg-light rounded">
                        <label class="text-muted small"><i class="fas fa-calendar me-1"></i>Bill Period</label>
                        <h6 class="mb-0 fw-bold">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) @Model.Year</h6>
                    </div>
                    <div class="mb-3 p-3 bg-light rounded">
                        <label class="text-muted small"><i class="fas fa-utensils me-1"></i>Meals Consumed</label>
                        <h6 class="mb-0"><span class="badge bg-primary fs-6">@Model.TotalMealsConsumed meals</span></h6>
                    </div>
                    <hr />
                    <div class="mb-2 p-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-hamburger me-1 text-success"></i>Food Bill:</span>
                            <strong class="text-success">Rs. @Model.FoodBill</strong>
                        </div>
                    </div>
                    <div class="mb-2 p-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-tint me-1 text-info"></i>Water Bill:</span>
                            <strong class="text-info">Rs. @Model.WaterBill</strong>
                        </div>
                    </div>
                    @if (Model.UnpaidBalance > 0)
                    {
                        <div class="mb-2">
                            <div class="d-flex justify-content-between text-danger">
                                <span>Previous Balance:</span>
                                <strong>Rs. @Model.UnpaidBalance</strong>
                            </div>
                        </div>
                    }
                    <hr class="border-2" />
                    <div class="mb-0 p-3 rounded" style="background: linear-gradient(135deg, rgba(17, 153, 142, 0.1) 0%, rgba(56, 239, 125, 0.1) 100%); border: 2px solid #11998e;">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="fas fa-money-bill-wave me-2"></i>Total Amount:</h5>
                            <h4 class="mb-0 fw-bold" style="color: #11998e;">Rs. @Model.TotalBill</h4>
                        </div>
                        <small class="text-muted d-block mt-2"><i class="fas fa-shield-check me-1"></i>Secured payment gateway</small>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.PaymentToken))
                    {
                        <hr />
                        <div class="alert alert-warning mb-0">
                            <small><strong>Payment Token:</strong></small><br />
                            <code>@Model.PaymentToken</code>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Payment Form -->
        <div class="col-md-8\">
            <style>
                @@keyframes slideIn {
                    from { opacity: 0; transform: translateX(-20px); }
                    to { opacity: 1; transform: translateX(0); }
                }
                .form-control:focus {
                    border-color: #11998e;
                    box-shadow: 0 0 0 0.2rem rgba(17, 153, 142, 0.25);
                }
                .btn:hover {
                    transform: translateY(-2px);
                    transition: all 0.3s ease;
                }
            </style>
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-credit-card"></i> Payment Gateway (Dummy)</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> <strong>Demo Payment Gateway</strong><br />
                        This is a dummy payment gateway for testing. Use any 16-digit card number.
                    </div>

                    <form asp-action="ProcessPayment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="billId" value="@Model.BillId" />

                        <div class="row mb-3">
                            <div class="col-12">
                                <label for="cardNumber" class="form-label">
                                    <i class="fas fa-credit-card"></i> Card Number <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control form-control-lg" id="cardNumber" name="cardNumber" 
                                       placeholder="1234 5678 9012 3456" maxlength="19" required
                                       pattern="\d{4}\s?\d{4}\s?\d{4}\s?\d{4}" 
                                       oninput="formatCardNumber(this)">
                                <small class="text-muted">Enter any 16-digit number for testing</small>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <label for="cardHolderName" class="form-label">
                                    <i class="fas fa-user"></i> Card Holder Name <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control" id="cardHolderName" name="cardHolderName" 
                                       placeholder="JOHN DOE" required style="text-transform: uppercase;">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="expiryDate" class="form-label">
                                    <i class="fas fa-calendar"></i> Expiry Date <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control" id="expiryDate" name="expiryDate" 
                                       placeholder="MM/YY" maxlength="5" required
                                       pattern="\d{2}/\d{2}" 
                                       oninput="formatExpiry(this)">
                            </div>
                            <div class="col-md-6">
                                <label for="cvv" class="form-label">
                                    <i class="fas fa-lock"></i> CVV <span class="text-danger">*</span>
                                </label>
                                <input type="password" class="form-control" id="cvv" name="cvv" 
                                       placeholder="123" maxlength="3" required
                                       pattern="\d{3}">
                            </div>
                        </div>

                        <div class="card bg-light mb-3">
                            <div class="card-body">
                                <h6 class="card-title">Test Card Details (For Demo):</h6>
                                <p class="mb-1"><strong>Card Number:</strong> 4111 1111 1111 1111</p>
                                <p class="mb-1"><strong>Name:</strong> Any Name</p>
                                <p class="mb-1"><strong>Expiry:</strong> Any future date (MM/YY)</p>
                                <p class="mb-0"><strong>CVV:</strong> Any 3 digits</p>
                            </div>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="terms" required>
                            <label class="form-check-label" for="terms">
                                I agree to the terms and conditions for this payment
                            </label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-success btn-lg" id="payNowBtn" onclick="processPayment()">
                                <i class="fas fa-check-circle"></i> Pay Rs. @Model.TotalBill Now
                            </button>
                            <a asp-action="ViewBills" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>

                    <div class="mt-4 text-center">
                        <small class="text-muted">
                            <i class="fas fa-shield-alt"></i> Secured by SSL Encryption (Demo)
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function formatCardNumber(input) {
            let value = input.value.replace(/\s/g, '');
            let formattedValue = value.match(/.{1,4}/g)?.join(' ') || value;
            input.value = formattedValue;
        }

        function formatExpiry(input) {
            let value = input.value.replace(/\D/g, '');
            if (value.length >= 2) {
                value = value.substring(0, 2) + '/' + value.substring(2, 4);
            }
            input.value = value;
        }

        // AJAX Payment Processing
        async function processPayment() {
            const form = document.querySelector('form');
            const cardNumber = document.getElementById('cardNumber').value;
            const cardHolderName = document.getElementById('cardHolderName').value;
            const expiryDate = document.getElementById('expiryDate').value;
            const cvv = document.getElementById('cvv').value;
            const terms = document.getElementById('terms').checked;
            const billId = @Model.BillId;
            
            // Validate form
            if (!cardNumber || cardNumber.replace(/\s/g, '').length < 16) {
                MMS.toast.error('Please enter a valid 16-digit card number.');
                return;
            }
            
            if (!cardHolderName) {
                MMS.toast.error('Please enter the card holder name.');
                return;
            }
            
            if (!expiryDate || expiryDate.length < 5) {
                MMS.toast.error('Please enter a valid expiry date (MM/YY).');
                return;
            }
            
            if (!cvv || cvv.length < 3) {
                MMS.toast.error('Please enter a valid 3-digit CVV.');
                return;
            }
            
            if (!terms) {
                MMS.toast.error('Please agree to the terms and conditions.');
                return;
            }
            
            const payBtn = document.getElementById('payNowBtn');
            payBtn.disabled = true;
            payBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing Payment...';
            
            try {
                const result = await MMS.post(`/api/api/bills/${billId}/pay`, {
                    cardNumber: cardNumber,
                    cardHolderName: cardHolderName,
                    expiryDate: expiryDate,
                    cvv: cvv,
                    paymentMethod: 'Card'
                });
                
                if (result.success) {
                    // Show success message with transaction details
                    const successHtml = `
                        <div class="text-center py-4">
                            <div class="mb-3">
                                <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
                            </div>
                            <h3 class="text-success mb-3">Payment Successful!</h3>
                            <p class="mb-2"><strong>Amount Paid:</strong> Rs. ${result.data.amount}</p>
                            <p class="mb-2"><strong>Transaction ID:</strong> <code>${result.data.transactionId}</code></p>
                            <p class="mb-4"><strong>Date:</strong> ${new Date(result.data.paidDate).toLocaleString()}</p>
                            <a href="/Teachers/ViewBills" class="btn btn-success btn-lg">
                                <i class="fas fa-arrow-left me-2"></i>Back to Bills
                            </a>
                        </div>
                    `;
                    
                    document.querySelector('.card-body').innerHTML = successHtml;
                    MMS.toast.success('Payment completed successfully!');
                } else {
                    MMS.toast.error(result.message || 'Payment failed. Please try again.');
                    payBtn.disabled = false;
                    payBtn.innerHTML = '<i class="fas fa-check-circle"></i> Pay Rs. @Model.TotalBill Now';
                }
            } catch (error) {
                MMS.toast.error(error.message || 'An error occurred while processing payment.');
                payBtn.disabled = false;
                payBtn.innerHTML = '<i class="fas fa-check-circle"></i> Pay Rs. @Model.TotalBill Now';
            }
        }

        // Add card type detection and icon
        document.getElementById('cardNumber').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\s/g, '');
            let icon = document.querySelector('.card-icon');
            
            if (value.startsWith('4')) {
                e.target.classList.remove('is-invalid');
                e.target.classList.add('is-valid');
            } else if (value.length >= 1) {
                // Accept any number for demo
                e.target.classList.remove('is-invalid');
                e.target.classList.add('is-valid');
            }
        });
    </script>
}
